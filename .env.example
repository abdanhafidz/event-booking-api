# Server
HOST_ADDRESS=0.0.0.0
HOST_PORT=8080

# Database (Supabase: use the Session pooler, port 5432)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=postgres
DB_SSLMODE=require
DB_POOL_SIZE=20

# Booking rules
HOLD_TTL=10m
SWEEP_INTERVAL=5s
SWEEPER_ENABLED=true
PAYMENT_TIMEOUT=2s
MOCKPAY_LATENCY_MS=0
IDEMPOTENCY_TTL=24h
REQUEST_TIMEOUT=4s
