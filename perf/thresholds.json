    "strict": { "max_error_pct": 0 },
    "targets": {
      "p95_ms": { "GET /events/{id}": 50, "POST /bookings": 100, "POST /bookings/{id}/pay": 250 }
    }
  },
  "PT-02": {
    "enforce": false,
    "strict": {},
